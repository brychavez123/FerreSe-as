# Plantilla. Copia este archivo como "keystore.properties" (en esta misma
# carpeta) y reemplaza los valores por los tuyos. keystore.properties esta
# en .gitignore: NO lo subas al repositorio.
#
# storeFile es relativo a la raiz del proyecto (o una ruta absoluta).
storeFile=ferresenas-release.jks
storePassword=CAMBIAR
keyAlias=ferresenas
keyPassword=CAMBIAR
